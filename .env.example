# --- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=8000
HOST=127.0.0.1

# Session cookie signing. REQUIRED in production (a long random value).
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=dev-secret-change-me

# --- Data store ------------------------------------------------------------
# postgres (this app targets PostgreSQL). With no DATABASE_URL an embedded
# PostgreSQL (pglite) is used, persisted under app-js/data/pg; set DATABASE_URL
# to use a managed PostgreSQL server. `sqlite` remains available for quick dev.
DB_RUNTIME=postgres
# DATABASE_URL=postgres://user:pass@host:5432/uits_vmtl
# PG_SSL=1
# PGLITE_DIR=./data/pg
# VMTL_DB=./data/vmtl.sqlite   # only when DB_RUNTIME=sqlite
# SESSION_STORE=postgres
# Server backup copies must be on persistent storage; download off-server copies too.
# VMTL_BACKUP_DIR=./data/backups

# Optional defaults for the Walkin-style Tekmail and mNotify connections.
# Saved connection settings take precedence. Configure and test in Email / SMS.
# MAIL_API_URL=https://tekmail-hub.knust.edu.gh/api/v1/email/send
# MAIL_API_KEY=
# MAIL_APP_ID=UITS VMTL
# MAIL_CHANNEL=VMTL
# SMS_API_URL=https://api.mnotify.com/api/sms/quick
# SMS_API_KEY=

# Links and the logo in outgoing email. EMAIL_LOGO_URL defaults to $APP_URL/email-logo.png.
# APP_URL=https://vmtl.knust.edu.gh
# EMAIL_LOGO_URL=

# Optional default for the Unified API staff directory (saved settings take precedence).
# UNIFIED_API_URL=
# UNIFIED_API_KEY=
# UNIFIED_API_TIMEOUT_MS=

# --- File storage & encrypted credentials ---------------------------------
# Encrypts File Server (S3 / Supabase) credentials and database connection
# profiles. Falls back to SESSION_SECRET. Keep it stable and back it up
# separately: changing it makes remotely stored files and saved profiles unreadable.
# DATABASE_PROFILE_ENCRYPTION_KEY=
# Timeout for each File Server request (ms).
# STORAGE_TIMEOUT_MS=60000

# --- Idle logout -----------------------------------------------------------
# A web browser signs out after this many minutes of inactivity...
IDLE_TIMEOUT_MINUTES=30
# ...and the installed PWA (desktop + mobile) after this many days.
PWA_IDLE_TIMEOUT_DAYS=30

# --- Sign-in lockout ---------------------------------------------------------
# Lock an identity after this many failed sign-ins within the window (minutes).
# LOGIN_LOCK_THRESHOLD=8
# LOGIN_LOCK_WINDOW_MIN=15

# --- Expiry alert thresholds (days) ----------------------------------------
ALERT_INSURANCE_DAYS=30
ALERT_ROADWORTHY_DAYS=30
ALERT_LICENCE_DAYS=30
# Service-due alerts are distance-based (within 500 km of each vehicle's
# service interval), so there is no days setting for them.

# --- Web Push (VAPID) ------------------------------------------------------
VAPID_SUBJECT=mailto:uits@knust.edu.gh
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Rate limits -----------------------------------------------------------
RATE_LIMIT_USER_PER_MIN=1200
RATE_LIMIT_IP_PER_MIN=2000
# Network-wide backstop across all users behind one IP (e.g. campus NAT).
# RATE_LIMIT_IP_BACKSTOP_PER_MIN=12000

# --- PostgreSQL pool & shutdown ----------------------------------------------
# PG_POOL_MAX=10
# PG_STATEMENT_TIMEOUT_MS=20000
# Time allowed for in-flight requests to finish on shutdown (ms).
# SHUTDOWN_GRACE_MS=10000
